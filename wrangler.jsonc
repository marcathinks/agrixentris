// Konfigurasi Cloudflare Workers. Nama harus sama dengan nama Worker di dashboard Cloudflare.
// Kunci rahasia ADMIN_PASSWORD dan GITHUB_TOKEN diisi di dashboard (Settings > Variables and Secrets),
// bukan di file ini.
{
  "name": "agrixentris",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // /produk disajikan dari produk.html, dan /produk.html dialihkan ke /produk.
    "html_handling": "auto-trailing-slash",
    // Alamat yang tidak ada menampilkan 404.html.
    "not_found_handling": "404-page",
    // Hanya API yang menjalankan kode Worker; halaman dan gambar disajikan langsung (gratis, tanpa batas).
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GITHUB_REPO": "marcathinks/agrixentris",
    "GITHUB_BRANCH": "main"
  },
  "observability": { "enabled": true }
}
