/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# assets/img/ tidak diberi cache panjang: nama filenya tetap, jadi foto yang diganti
# dengan nama sama harus langsung terlihat. Browser tetap memakai salinannya selama
# file di server tidak berubah (dicek lewat ETag).

# uploads/ aman di-cache setahun: nama file diambil dari isi foto, jadi foto baru selalu bernama baru.
/uploads/*
  Cache-Control: public, max-age=31536000, immutable
